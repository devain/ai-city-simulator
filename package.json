{
  "name": "ai-city-simulator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=scripts/verify.mjs --log-level=error && node scripts/verify.mjs",
    "verify:planner": "esbuild scripts/verifyPlanner.ts --bundle --platform=node --format=esm --outfile=scripts/verifyPlanner.mjs --log-level=error && node scripts/verifyPlanner.mjs",
    "verify:nlu": "esbuild scripts/verifyNlu.ts --bundle --platform=node --format=esm --outfile=scripts/verifyNlu.mjs --log-level=error && node scripts/verifyNlu.mjs",
    "verify:sandbox": "esbuild scripts/verifySandbox.ts --bundle --platform=node --format=esm --outfile=scripts/verifySandbox.mjs --log-level=error && node scripts/verifySandbox.mjs",
    "verify:challenge": "esbuild scripts/verifyChallenge.ts --bundle --platform=node --format=esm --outfile=scripts/verifyChallenge.mjs --log-level=error && node scripts/verifyChallenge.mjs"
  },
  "dependencies": {
    "@react-three/drei": "9.114.3",
    "@react-three/fiber": "8.17.10",
    "@react-three/postprocessing": "^2.16.3",
    "postprocessing": "^6.36.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "2.13.3",
    "three": "0.169.0",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "4.3.3",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.15",
    "typescript": "5.6.3",
    "vite": "5.4.11"
  }
}
